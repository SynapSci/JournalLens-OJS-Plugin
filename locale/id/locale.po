msgid "plugins.generic.journalLens.displayName"
msgstr "Lencana Kredibilitas JournalLens"

msgid "plugins.generic.journalLens.description"
msgstr "Menampilkan Skor Kredibilitas JournalLens jurnal ini di footer halaman dan/atau sidebar. Skor hanya muncul di situs web terdaftar jurnal; pembaca dapat memeriksa lencana apa pun di JournalLens. Jurnal diidentifikasi melalui ISSN online atau cetak."

msgid "plugins.generic.journalLens.settings.baseUrl"
msgstr "Alamat JournalLens"

msgid "plugins.generic.journalLens.settings.baseUrlDescription"
msgstr "Biarkan nilai bawaan (https://journallens.info) kecuali diminta oleh dukungan JournalLens. Harus diawali dengan https://."

msgid "plugins.generic.journalLens.settings.baseUrlInvalid"
msgstr "Masukkan alamat https:// yang valid."

msgid "plugins.generic.journalLens.settings.placement"
msgstr "Penempatan"

msgid "plugins.generic.journalLens.settings.placementDescription"
msgstr "Lencana juga dapat ditampilkan di sidebar: tambahkan \"Lencana Kredibilitas JournalLens (sidebar)\" di Situs Web > Tampilan > Pengaturan > Manajemen Sidebar."

msgid "plugins.generic.journalLens.settings.showInFooter"
msgstr "Tampilkan lencana di footer halaman"

msgid "plugins.generic.journalLens.badge.alt"
msgstr "Skor Kredibilitas JournalLens"

msgid "plugins.generic.journalLens.badge.linkTitle"
msgstr "Periksa lencana jurnal ini di JournalLens"

msgid "plugins.generic.journalLens.block.displayName"
msgstr "Lencana Kredibilitas JournalLens (sidebar)"

msgid "plugins.generic.journalLens.block.description"
msgstr "Blok sidebar yang menampilkan Skor Kredibilitas JournalLens jurnal ini."

msgid "plugins.generic.journalLens.block.title"
msgstr "JournalLens"
