msgid "plugins.generic.journalLens.displayName"
msgstr "Selo de credibilidade JournalLens"

msgid "plugins.generic.journalLens.description"
msgstr "Exibe a pontuação de credibilidade JournalLens desta revista no rodapé e/ou na barra lateral. A pontuação aparece apenas nos sites registrados da revista; os leitores podem verificar qualquer selo no JournalLens. A revista é identificada pelo ISSN eletrônico ou impresso."

msgid "plugins.generic.journalLens.settings.baseUrl"
msgstr "Endereço do JournalLens"

msgid "plugins.generic.journalLens.settings.baseUrlDescription"
msgstr "Mantenha o valor padrão (https://journallens.info), a menos que o suporte do JournalLens solicite a alteração. Deve começar com https://."

msgid "plugins.generic.journalLens.settings.baseUrlInvalid"
msgstr "Informe um endereço https:// válido."

msgid "plugins.generic.journalLens.settings.placement"
msgstr "Posição"

msgid "plugins.generic.journalLens.settings.placementDescription"
msgstr "O selo também pode ser exibido na barra lateral: adicione \"Selo de credibilidade JournalLens (barra lateral)\" em Website > Aparência > Configuração > Gerenciamento da barra lateral."

msgid "plugins.generic.journalLens.settings.showInFooter"
msgstr "Exibir o selo no rodapé da página"

msgid "plugins.generic.journalLens.badge.alt"
msgstr "Pontuação de credibilidade JournalLens"

msgid "plugins.generic.journalLens.badge.linkTitle"
msgstr "Verificar o selo desta revista no JournalLens"

msgid "plugins.generic.journalLens.block.displayName"
msgstr "Selo de credibilidade JournalLens (barra lateral)"

msgid "plugins.generic.journalLens.block.description"
msgstr "Bloco da barra lateral que exibe a pontuação de credibilidade JournalLens desta revista."

msgid "plugins.generic.journalLens.block.title"
msgstr "JournalLens"
